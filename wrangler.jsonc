{
  // Per-environment Worker projects (klappy://canon/constraints/per-environment-worker-projects):
  // dev → nehemiahs-wall-dev, staging → nehemiahs-wall-staging, production → nehemiahs-wall.
  // Auth: AUTH_MODE "key" everywhere; MCP_KEY / BUILDER_KEY are secrets set per env (never in this file).
  // Open no-key mode exists only for ENVIRONMENT=local via an untracked .dev.vars (docs/SECURITY.md).
  // Each env gets its own Worker and its own Room Durable Object namespace. Deploys: Workers Builds git hook.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nehemiahs-wall",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "REGISTRY", "class_name": "RoomRegistry" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["RoomRegistry"] }],
  "vars": { "ENVIRONMENT": "production", "VERSION": "0.0.1-scaffold", "AUTH_MODE": "key" },
  "env": {
    "dev": {
      "name": "nehemiahs-wall-dev",
      "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "REGISTRY", "class_name": "RoomRegistry" }] },
      "vars": { "ENVIRONMENT": "dev", "VERSION": "0.0.1-scaffold", "AUTH_MODE": "key" }
    },
    "staging": {
      "name": "nehemiahs-wall-staging",
      "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }, { "name": "REGISTRY", "class_name": "RoomRegistry" }] },
      "vars": { "ENVIRONMENT": "staging", "VERSION": "0.0.1-scaffold", "AUTH_MODE": "key" }
    }
  }
}
